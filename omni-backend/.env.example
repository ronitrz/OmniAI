# ════════════════════════════════════════════════════════════════
# OmniAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ── APPLICATION ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Your deployed Angular frontend URL (or localhost for dev)
FRONTEND_URL=http://localhost:4200

# ── DATABASE ─────────────────────────────────────────────────────
# Local PostgreSQL:  postgresql://USER:PASSWORD@localhost:5432/omni_ai
# Neon.tech (free):  postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/omni_ai?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/omni_ai

# ── JWT ──────────────────────────────────────────────────────────
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ── AI PROVIDER KEYS ─────────────────────────────────────────────
# Leave a key BLANK to automatically use MockProvider for that model.
# Populate a key to use the real live API.

# Google Gemini (FREE TIER available)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek (5 MILLION FREE TOKENS on signup)
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI (Paid — leave blank to use MockProvider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Paid — leave blank to use MockProvider)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── MOCK MODE ────────────────────────────────────────────────────
# true  → Providers without API keys return realistic simulated responses (DEMO mode)
# false → Providers without API keys return an error (STRICT mode)
MOCK_MODE=true
