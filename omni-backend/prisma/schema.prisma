// prisma/schema.prisma
// OmniAI V1 Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── USERS ─────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  createdAt    DateTime    @default(now()) @map("created_at")
  workspaces   Workspace[]

  @@map("users")
}

// ── WORKSPACES ────────────────────────────────────────────────

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("workspaces")
}

// ── SESSIONS ──────────────────────────────────────────────────

model Session {
  id          String    @id @default(uuid())
  title       String    @default("New Conversation")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("sessions")
}

// ── MESSAGES ──────────────────────────────────────────────────

model Message {
  id             String          @id @default(uuid())
  role           String          // "user" | "assistant"
  content        String
  selectedModels String[]        @map("selected_models")
  mode           String          @default("standard") // "standard" | "research"
  sessionId      String          @map("session_id")
  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses      ModelResponse[]
  juryVerdict    JuryVerdict?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("messages")
}

// ── MODEL RESPONSES ───────────────────────────────────────────

model ModelResponse {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  modelId   String   @map("model_id")    // "gemini-flash", "deepseek-chat", "gpt-4o", "claude-haiku"
  modelName String   @map("model_name")  // Display name: "Gemini Flash", "DeepSeek", "GPT-4o", "Claude"
  content   String
  isMock    Boolean  @default(false) @map("is_mock") // Internal only — never sent to frontend
  status    String   @default("success") // "success" | "error" | "timeout"
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("model_responses")
}

// ── JURY VERDICTS ─────────────────────────────────────────────

model JuryVerdict {
  id              String   @id @default(uuid())
  messageId       String   @unique @map("message_id")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  consensusText   String   @map("consensus_text")
  confidenceScore Float    @map("confidence_score") // 0.0 – 1.0
  confidenceLabel String   @map("confidence_label") // "HIGH" | "MEDIUM" | "LOW"
  agreements      Json     // string[]
  contradictions  Json     // { topic: string, positions: Record<string, string> }[]
  uniqueInsights  Json     @map("unique_insights") // { modelId: string, insight: string }[]
  recommendation  String
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("jury_verdicts")
}
