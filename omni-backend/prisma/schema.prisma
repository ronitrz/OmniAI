generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  createdAt    DateTime    @default(now()) @map("created_at")
  workspaces   Workspace[]

  @@map("users")
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sessions    Session[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

model Session {
  id          String    @id @default(uuid())
  title       String    @default("New Conversation")
  workspaceId String    @map("workspace_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  messages    Message[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Message {
  id             String          @id @default(uuid())
  role           String
  content        String
  selectedModels String[]        @map("selected_models")
  mode           String          @default("standard")
  sessionId      String          @map("session_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  juryVerdict    JuryVerdict?
  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses      ModelResponse[]

  @@map("messages")
}

model ModelResponse {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  modelId   String   @map("model_id")
  modelName String   @map("model_name")
  content   String
  isMock    Boolean  @default(false) @map("is_mock")
  status    String   @default("success")
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("model_responses")
}

model JuryVerdict {
  id              String   @id @default(uuid())
  messageId       String   @unique @map("message_id")
  consensusText   String   @map("consensus_text")
  confidenceScore Float    @map("confidence_score")
  confidenceLabel String   @map("confidence_label")
  agreements      Json
  contradictions  Json
  uniqueInsights  Json     @map("unique_insights")
  recommendation  String
  createdAt       DateTime @default(now()) @map("created_at")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("jury_verdicts")
}
